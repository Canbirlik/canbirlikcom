---
import Icon from './Icon.astro';
import { profile } from '../data/profile';
---

<aside class="fixed bottom-0 left-6 z-30 hidden flex-col items-center gap-5 xl:flex" aria-label="Social links">
  {
    profile.socials.map((s) => (
      <a
        href={s.href}
        target={s.href.startsWith('http') ? '_blank' : undefined}
        rel={s.href.startsWith('http') ? 'noopener' : undefined}
        class="text-muted transition hover:-translate-y-0.5 hover:text-accent"
        aria-label={s.label}
      >
        <Icon name={s.icon} />
      </a>
    ))
  }
  <span class="h-24 w-px bg-line" aria-hidden="true"></span>
</aside>
