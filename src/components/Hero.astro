---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import photo from '../assets/can.png';
import { profile } from '../data/profile';
---

<section id="top" class="container-page grid min-h-[100svh] items-center gap-12 pt-24 pb-16 md:grid-cols-[1.15fr_1fr]">
  <div class="order-2 md:order-1">
    <p class="font-display text-4xl font-medium text-accent sm:text-5xl" data-reveal>
      Hi! <span class="inline-block origin-[70%_70%] motion-safe:animate-[wave_2.4s_ease-in-out_1s_2]">👋</span>
    </p>
    <h1 class="mt-6 font-display text-4xl leading-tight font-bold tracking-tight sm:text-6xl" data-reveal>
      <span class="block text-xl font-normal tracking-wide text-muted sm:text-2xl">my name is</span>
      {profile.name}
    </h1>
    <p class="mt-4 text-lg font-medium text-accent sm:text-xl" data-reveal>{profile.tagline}</p>
    <p class="mt-6 max-w-xl leading-relaxed text-muted" data-reveal>
      <strong class="font-semibold text-ink">{profile.title}</strong> based in {profile.location}. {profile.summary}
    </p>

    <div class="mt-10 flex flex-wrap items-center gap-4" data-reveal>
      <a
        href="#contact"
        class="group inline-flex items-center gap-2 rounded-full bg-ink px-6 py-3 text-sm font-semibold tracking-wide text-paper transition hover:bg-accent"
      >
        Get in touch
        <Icon name="arrowRight" class="size-4 transition-transform group-hover:translate-x-1" />
      </a>
      <a
        href="#experience"
        class="inline-flex items-center gap-2 rounded-full border border-line px-6 py-3 text-sm font-semibold tracking-wide transition hover:border-ink"
      >
        See my journey
      </a>
    </div>

    <dl class="mt-14 grid max-w-sm grid-cols-2 gap-6 border-t border-line pt-8" data-reveal>
      {
        profile.stats.map((s) => (
          <div>
            <dt class="sr-only">{s.label}</dt>
            <dd class="font-display text-3xl font-bold">{s.value}</dd>
            <dd class="mt-1 text-xs leading-snug text-muted">{s.label}</dd>
          </div>
        ))
      }
    </dl>
  </div>

  <div class="order-1 flex justify-center md:order-2" data-reveal>
    <div class="relative w-60 sm:w-80 md:w-full md:max-w-sm">
      <div class="absolute inset-0 translate-x-4 translate-y-4 rounded-[2rem] border-2 border-accent" aria-hidden="true"></div>
      <Image
        src={photo}
        alt="Portrait of Can Birlik"
        widths={[320, 480, 720]}
        sizes="(min-width: 768px) 384px, 320px"
        loading="eager"
        fetchpriority="high"
        class="relative aspect-square w-full rounded-[2rem] object-cover shadow-xl"
      />
      <span
        class="absolute -bottom-5 -left-4 inline-flex items-center gap-1.5 rounded-full border border-line bg-card px-4 py-2 text-sm font-medium shadow-md"
      >
        <Icon name="pin" class="size-4 text-accent" />
        {profile.location}
      </span>
    </div>
  </div>
</section>

<style is:global>
  @keyframes wave {
    0%, 60%, 100% { transform: rotate(0deg); }
    10%, 30% { transform: rotate(14deg); }
    20% { transform: rotate(-8deg); }
    40% { transform: rotate(-4deg); }
    50% { transform: rotate(10deg); }
  }
</style>
