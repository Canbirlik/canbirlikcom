---
import Icon from './Icon.astro';
import { featuredTech, skillGroups } from '../data/profile';
---

<section id="skills" class="border-y border-line bg-card py-24">
  <div class="container-page">
    <p class="eyebrow" data-reveal>What I work with</p>
    <h2 class="section-title mt-3" data-reveal>I'm good at this</h2>

    <ul class="mt-12 grid grid-cols-5 gap-x-4 gap-y-8 sm:grid-cols-10" data-reveal>
      {
        featuredTech.map((t) => (
          <li class="group flex flex-col items-center gap-2 text-muted transition-colors hover:text-accent">
            <Icon name={t.icon} class="size-9 transition-transform group-hover:-translate-y-1" title={t.name} />
            <span class="text-xs tracking-wide">{t.name}</span>
          </li>
        ))
      }
    </ul>

    <div class="mt-16 grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
      {
        skillGroups.map((g) => (
          <div data-reveal>
            <h3 class="font-display text-sm font-semibold tracking-[0.15em] uppercase">{g.title}</h3>
            <ul class="mt-4 flex flex-wrap gap-2">
              {g.items.map((item) => (
                <li class="rounded-full border border-line px-3 py-1 text-sm text-muted">{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
