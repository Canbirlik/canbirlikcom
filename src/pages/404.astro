---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found | Can Birlik">
  <main id="main" class="grid-paper grid min-h-screen place-items-center px-4 text-center">
    <div class="rounded-3xl border border-line bg-card px-10 py-14 shadow-sm">
      <p class="font-display text-7xl font-bold text-accent">404</p>
      <h1 class="mt-4 font-display text-2xl font-bold">This page took a wrong turn.</h1>
      <a href="/" class="mt-8 inline-block rounded-full bg-ink px-6 py-3 text-sm font-semibold text-paper hover:bg-accent">Back home</a>
    </div>
  </main>
</Layout>
